# Copy to .env and fill in. Never commit .env.
# Demo mode (default) needs none of the keys below.

# 1 = demo mode: mock store, mock tools, DNS fixtures, recorded Claude answers. 0 = live.
DEMO_MODE=1
PORT=3000
# Public address of this server. Used by the mock store in demo mode.
BASE_URL=http://localhost:3000
# Where the SQLite database and the buyer list CSV are written.
DB_PATH=data/guard.db
DATA_DIR=data
# Optional: protects the dashboard and its API with a username and password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Receiver ---
# Shared secret the store uses to sign webhooks (HMAC SHA-256). Required when DEMO_MODE=0.
STORE_WEBHOOK_SECRET=
# How old a signature may be before it is rejected, in seconds.
SIGNATURE_TOLERANCE_SECONDS=300

# --- Delivery worker ---
# Tries per delivery before it goes to the dead letter queue.
MAX_ATTEMPTS=8
# First retry pause, and the longest pause, in milliseconds (doubles each try).
BACKOFF_BASE_MS=30000
BACKOFF_MAX_MS=3600000
# How long to wait for a tool to answer, in milliseconds.
REQUEST_TIMEOUT_MS=10000
WORKER_POLL_MS=1000

# --- Destinations ---
MEMBERSHIP_URL=
EMAIL_URL=
N8N_WEBHOOK_URL=

# --- Reconciliation ---
RECONCILE_INTERVAL_MINUTES=15
# How far back to compare, and how long to give a fresh purchase's webhook before calling it missed.
RECONCILE_LOOKBACK_MINUTES=1440
RECONCILE_GRACE_SECONDS=120
# The store's API used to list recent purchases.
SOURCE_API_URL=

# --- Incidents and Claude ---
# Failures from one tool inside the window that open an incident.
INCIDENT_FAILURE_THRESHOLD=5
INCIDENT_WINDOW_MINUTES=10
# Wait this long after an incident opens so the explanation covers the whole burst.
INCIDENT_DELAY_SECONDS=60
# Only used when DEMO_MODE=0.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Slack incoming webhook URL. Leave empty to keep alerts in the dashboard only.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#automation-alerts

# --- Email check ---
EMAIL_DOMAIN=demo-academy.example
# Comma separated DKIM selectors your email provider uses.
DKIM_SELECTORS=s1

# --- Buyer list sync ---
# csv (writes data/buyers.csv) or google
SHEETS_ADAPTER=csv
GOOGLE_SHEET_ID=
# The service account key as one line of JSON. Share the sheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
